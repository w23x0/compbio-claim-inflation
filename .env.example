# Copy to a file outside version control (e.g. secrets/llm.env) and fill in.
# M1/M4/P6/P7 need an OpenAI-compatible chat-completions endpoint.
export CBI_LLM_ENDPOINT="https://api.example.com/v1/chat/completions"
export CBI_LLM_MODEL="your-model-id"
export CBI_LLM_API_KEY=""

# Optional: OpenAI-style variable names are accepted as a fallback.
# export OPENAI_BASE_URL="https://api.example.com/v1"
# export OPENAI_MODEL="your-model-id"
# export OPENAI_API_KEY=""

# NCBI E-utilities key for PMC fetching (3 req/s without it).
export NCBI_API_KEY=""

# Grader token shared between the M6 grader service and P6 workers.
export CBI_GRADER_TOKEN=""

# Concurrency and batching (process-local HTTP cap included).
export CBI_LLM_MAX_CONCURRENCY="4"
export CBI_M1_BATCH_SIZE="4"
export CBI_EVIDENCE_BATCH_SIZE="4"
export CBI_M5_SCORE_BATCH="4"
export CBI_P4_WORKERS="8"
